{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Automerge minor and patch updates for all dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
