# TypeScript 7.1 is used as the project compiler (see `type-check` in
# package.json and the `contentMappers` in tsconfig.app.json), but
# typescript-eslint (used by `npm run lint:eslint`) still pins its
# `typescript` peer to <6.1.0 and cannot run on TypeScript 7 at all.
# Until typescript-eslint ships TypeScript 7 support, peer conflicts
# are resolved the npm v6 way. Remove this file when the ESLint stack
# supports TypeScript 7.
legacy-peer-deps=true
